+namespace
+{
+void require (bool ok, const char *what)
+{
+    if (!ok)
+        throw std::runtime_error (std::string (what) + ": "
+                                  + zmq_strerror (zmq_errno ()));
+}
+
+struct frame_t
+{
+    std::string data, id, fd, user, peer;
+};
+
+std::string property (zmq_msg_t *msg, const char *name)
+{
+    const char *value = zmq_msg_gets (msg, name);
+    return value ? value : "";
+}
+
+std::vector<frame_t> receive (void *socket)
+{
+    std::vector<frame_t> frames;
+    do {
+        zmq_msg_t msg;
+        require (zmq_msg_init (&msg) == 0, "message init");
+        const int rc = zmq_msg_recv (&msg, socket, 0);
+        if (rc < 0) {
+            zmq_msg_close (&msg);
+            require (false, "message receive");
+        }
+        frame_t f;
+        f.data.assign (static_cast<const char *> (zmq_msg_data (&msg)),
+                       zmq_msg_size (&msg));
+        f.id = property (&msg, ZMQ_MSG_PROPERTY_CONNECTION_ID);
+        f.fd = property (&msg, ZMQ_MSG_PROPERTY_TRANSPORT_FD);
+        f.user = property (&msg, "User-Id");
+        f.peer = property (&msg, "Peer-Address");
+        const bool more = zmq_msg_more (&msg) != 0;
+        zmq_msg_close (&msg);
+        frames.push_back (f);
+        if (!more)
+            return frames;
+    } while (true);
+}
+
+void send (void *socket, const std::vector<std::string> &frames)
+{
+    for (size_t i = 0; i != frames.size (); ++i)
+        require (zmq_send (socket, frames[i].data (), frames[i].size (),
+                           i + 1 < frames.size () ? ZMQ_SNDMORE : 0)
+                   >= 0,
+                 "multipart send");
+}
+
+void set_int (void *socket, int option, int value)
+{
+    require (zmq_setsockopt (socket, option, &value, sizeof (value)) == 0,
+             "integer option");
+}
+
+void set_string (void *socket, int option, const std::string &value)
+{
+    require (zmq_setsockopt (socket, option, value.data (), value.size ()) == 0,
+             "string option");
+}
+
+uint64_t read64 (const std::string &bytes)
+{
+    require (bytes.size () == sizeof (uint64_t), "64-bit monitor frame");
+    uint64_t value;
+    memcpy (&value, bytes.data (), sizeof (value));
+    return value;
+}
+
+std::string spoofed_metadata ()
+{
+    std::string result;
+    const char *names[] = {ZMQ_MSG_PROPERTY_CONNECTION_ID,
+                           ZMQ_MSG_PROPERTY_TRANSPORT_FD, "__fd",
+                           "Peer-Address"};
+    for (size_t i = 0; i != sizeof (names) / sizeof (*names); ++i) {
+        result += static_cast<char> (strlen (names[i]));
+        result += names[i];
+        result.append ("\0\0\0\1", 4);
+        result += '0';
+    }
+    return result;
+}
+
+struct binding_t
+{
+    uint64_t id, fd;
+    std::string user, route;
+    int requests;
+};
+
+class fixture_t
+{
+  public:
+    explicit fixture_t (int version, std::set<uint64_t> &all_ids) :
+        ctx (zmq_ctx_new ()),
+        version (version),
+        all_ids (all_ids),
+        accepted (0),
+        authenticated (0),
+        disconnected (0),
+        requests (0),
+        handshakes (0),
+        reused_fds (0)
+    {
+        require (ctx != NULL, "context");
+        require (zmq_ctx_set (ctx, ZMQ_IO_THREADS, 3) == 0, "I/O threads");
+        zap = socket (ZMQ_REP);
+        require (zmq_bind (zap, "inproc://zeromq.zap.01") == 0, "ZAP bind");
+        router = socket (ZMQ_ROUTER);
+        set_int (router, ZMQ_PLAIN_SERVER, 1);
+        set_int (router, ZMQ_ROUTER_MANDATORY, 1);
+        set_int (router, ZMQ_ROUTER_HANDOVER, 0);
+        set_string (router, ZMQ_ZAP_DOMAIN, "lifetime-test");
+        const char *monitor_endpoint = "inproc://lifetime-monitor";
+        require (zmq_socket_monitor_versioned (router, monitor_endpoint,
+                                               ZMQ_EVENT_ALL, version, ZMQ_PAIR)
+                   == 0,
+                 "monitor setup");
+        monitor = socket (ZMQ_PAIR);
+        require (zmq_connect (monitor, monitor_endpoint) == 0,
+                 "monitor connect");
+        endpoint = "ipc:///tmp/zmq-lifetime-" + std::to_string (getpid ()) + "-"
+                   + std::to_string (version) + ".ipc";
+        require (zmq_bind (router, endpoint.c_str ()) == 0, "ROUTER bind");
+    }
+
+    ~fixture_t ()
+    {
+        for (size_t i = 0; i != sockets.size (); ++i)
+            if (sockets[i])
+                zmq_close (sockets[i]);
+        zmq_ctx_term (ctx);
+        unlink (endpoint.substr (6).c_str ());
+    }
+
+    void *socket (int type)
+    {
+        void *s = zmq_socket (ctx, type);
+        require (s != NULL, "socket");
+        sockets.push_back (s);
+        set_int (s, ZMQ_LINGER, 0);
+        set_int (s, ZMQ_SNDTIMEO, 2000);
+        set_int (s, ZMQ_RCVTIMEO, 2000);
+        return s;
+    }
+
+    void close (void *s)
+    {
+        require (zmq_close (s) == 0, "socket close");
+        for (size_t i = 0; i != sockets.size (); ++i)
+            if (sockets[i] == s)
+                sockets[i] = NULL;
+    }
+
+    void *connect (const char *name, const char *route = NULL)
+    {
+        void *s = socket (ZMQ_DEALER);
+        set_string (s, ZMQ_ROUTING_ID, route ? route : name);
+        set_string (s, ZMQ_PLAIN_USERNAME, name);
+        set_string (s, ZMQ_PLAIN_PASSWORD, "dummy");
+        set_int (s, ZMQ_RECONNECT_IVL, -1);
+        set_int (s, ZMQ_IMMEDIATE, 1);
+        require (zmq_connect (s, endpoint.c_str ()) == 0, "DEALER connect");
+        return s;
+    }
+
+    void pump (const std::function<bool ()> &done)
+    {
+        const auto deadline =
+          std::chrono::steady_clock::now () + std::chrono::seconds (4);
+        while (!done ()) {
+            require (std::chrono::steady_clock::now () < deadline,
+                     "event deadline");
+            zmq_pollitem_t items[] = {{zap, 0, ZMQ_POLLIN, 0},
+                                      {monitor, 0, ZMQ_POLLIN, 0},
+                                      {router, 0, ZMQ_POLLIN, 0}};
+            require (zmq_poll (items, 3, 10) >= 0, "poll");
+            if (items[0].revents & ZMQ_POLLIN)
+                on_zap ();
+            if (items[1].revents & ZMQ_POLLIN)
+                on_monitor ();
+            if (items[2].revents & ZMQ_POLLIN)
+                on_request ();
+        }
+    }
+
+    void on_zap ()
+    {
+        const auto frames = receive (zap);
+        require (frames.size () == 8 && frames[0].data == "1.0"
+                   && frames[1].data == "1" && frames[5].data == "PLAIN",
+                 "unchanged PLAIN ZAP framing");
+        const frame_t &f = frames[3];
+        require (!f.id.empty () && !f.fd.empty (), "ZAP transport metadata");
+        binding_t b = {std::stoull (f.id), std::stoull (f.fd), "user-" + f.id,
+                       "", 0};
+        require (b.id != 0 && all_ids.insert (b.id).second,
+                 "unique lifetime across connections and contexts");
+        for (const auto &part : frames)
+            require (part.id == f.id && part.fd == f.fd && part.peer == f.data
+                       && part.user.empty (),
+                     "trusted binding on every ZAP body frame");
+        const std::string credentials =
+          "localhost:" + std::to_string (getuid ()) + ":"
+          + std::to_string (getgid ()) + ":" + std::to_string (getpid ());
+        require (f.data == credentials, "kernel peer credentials");
+        bindings.emplace (b.id, b);
+        names[frames[6].data] = b.id;
+        ++authenticated;
+        if (frames[6].data == "hold") {
+            held_reply = {frames[0].data, frames[1].data, "200",
+                          "OK",           b.user,         ""};
+        } else if (frames[6].data == "denied") {
+            send (zap,
+                  {frames[0].data, frames[1].data, "400", "DENIED", "", ""});
+        } else {
+            //  A ZAP handler cannot overwrite the library's transport identity.
+            send (zap, {frames[0].data, frames[1].data, "200", "OK", b.user,
+                        spoofed_metadata ()});
+        }
+    }
+
+    void on_monitor ()
+    {
+        const auto frames = receive (monitor);
+        uint64_t event;
+        std::vector<uint64_t> values;
+        if (version == 1) {
+            require (frames.size () == 2 && frames[0].data.size () == 6,
+                     "unchanged v1 event framing");
+            uint16_t type;
+            int32_t value;
+            memcpy (&type, frames[0].data.data (), sizeof (type));
+            memcpy (&value, frames[0].data.data () + 2, sizeof (value));
+            event = type;
+            values.push_back (value);
+        } else {
+            event = read64 (frames.at (0).data);
+            const uint64_t count = read64 (frames.at (1).data);
+            require (frames.size () == count + 4, "v2 multipart framing");
+            for (uint64_t i = 0; i != count; ++i)
+                values.push_back (read64 (frames[i + 2].data));
+        }
+        if (event == ZMQ_EVENT_HANDSHAKE_SUCCEEDED)
+            ++handshakes;
+        if (event == ZMQ_EVENT_ACCEPTED) {
+            ++accepted;
+            if (!seen_fds.insert (values[0]).second)
+                ++reused_fds;
+            if (version == 2) {
+                require (values.size () == 2 && values[1] != 0,
+                         "accepted FD and lifetime");
+                require (accepts.emplace (values[1], values[0]).second,
+                         "distinct accepted transport lifetime");
+            }
+        }
+        if (event == ZMQ_EVENT_DISCONNECTED) {
+            ++disconnected;
+            if (version == 2) {
+                require (values.size () == 5 && values[1] == getuid ()
+                           && values[2] == getgid () && values[3] == getpid ()
+                           && values[4] != 0,
+                         "disconnect FD/UID/GID/PID/lifetime");
+                require (closes.emplace (values[4], values[0]).second,
+                         "one disconnect per lifetime");
+            }
+        }
+    }
+
+    void on_request ()
+    {
+        const auto frames = receive (router);
+        require (frames.size () == 2, "ROUTER framing");
+        const frame_t &f = frames[1];
+        require (!f.id.empty (), "request lifetime metadata");
+        binding_t &b = bindings.at (std::stoull (f.id));
+        require (std::stoull (f.fd) == b.fd && f.user == b.user,
+                 "request matches authenticated lifetime");
+        require (frames[0].id == f.id && frames[0].fd == f.fd,
+                 "prefetched routing frame retains metadata");
+        require (f.peer != "0", "native properties resist ZAP override");
+        b.route = frames[0].data;
+        ++b.requests;
+        ++requests;
+    }
+
+    void reply (const std::string &route, uint64_t id, bool expected_success)
+    {
+        require (zmq_setsockopt (router, ZMQ_ROUTER_EXPECTED_CONNECTION_ID, &id,
+                                 sizeof (id))
+                   == 0,
+                 "set expected route lifetime");
+        const int rc = zmq_send (router, route.data (), route.size (),
+                                 ZMQ_SNDMORE | ZMQ_DONTWAIT);
+        if (expected_success) {
+            require (rc >= 0, "guard accepts original connection");
+            require (zmq_send (router, "reply", 5, ZMQ_DONTWAIT) == 5,
+                     "send guarded body");
+        } else {
+            require (rc == -1 && zmq_errno () == EHOSTUNREACH,
+                     "guard rejects stale route before multipart body");
+        }
+    }
+
+    void run ()
+    {
+        void *a = connect ("A"), *b = connect ("B"), *c = connect ("C");
+        pump ([&] { return handshakes == 3 && accepted == 3; });
+        const uint64_t original = names.at ("A");
+        require (original != names.at ("B") && original != names.at ("C"),
+                 "same process has distinct authenticated connections");
+        send (a, {"request A"});
+        send (c, {"request C"});
+        pump ([&] { return requests == 2; });
+        reply ("A", original, true);
+        require (receive (a).at (0).data == "reply", "guarded reply received");
+
+        close (b);
+        pump ([&] { return disconnected == 1; });
+        require (
+          bindings.at (names.at ("B")).requests == 0,
+          "silent authenticated connection has no request-derived state");
+        if (version == 2)
+            require (closes.count (names.at ("B")) == 1
+                       && closes.count (original) == 0
+                       && closes.count (names.at ("C")) == 0,
+                     "only the silent connection disconnects");
+
+        //  Deliberately force a route takeover to exercise the atomic guard.
+        set_int (router, ZMQ_ROUTER_HANDOVER, 1);
+        void *replacement = connect ("replacement", "A");
+        pump ([&] { return handshakes == 4 && accepted == 4; });
+        send (replacement, {"new A"});
+        pump ([&] { return requests == 3; });
+        reply ("A", original, false);
+        reply ("A", names.at ("replacement"), true);
+        require (receive (replacement).at (0).data == "reply",
+                 "new connection receives only its own reply");
+        char byte;
+        require (zmq_recv (replacement, &byte, 1, ZMQ_DONTWAIT) == -1
+                   && zmq_errno () == EAGAIN,
+                 "no stale response leaked to replacement");
+        close (a);
+        close (c);
+        close (replacement);
+        pump ([&] { return disconnected == 4; });
+        set_int (router, ZMQ_ROUTER_HANDOVER, 0);
+
+        for (int i = 0; i != 12; ++i) {
+            const std::string name = "fresh-" + std::to_string (i);
+            void *s = connect (name.c_str ());
+            pump ([&] { return handshakes == 5 + i && accepted == 5 + i; });
+            close (s);
+            pump ([&] { return disconnected == 5 + i; });
+        }
+        require (reused_fds > 0, "exercise actual FD reuse");
+
+        void *denied = connect ("denied");
+        pump ([&] { return authenticated == 17 && disconnected == 17; });
+        close (denied);
+
+        void *held = connect ("hold");
+        pump ([&] { return authenticated == 18; });
+        close (held);
+        pump ([&] { return disconnected == 18; });
+        send (zap, held_reply);
+
+        //  A raw UDS peer closes before it ever reaches ZAP.
+        const int raw = ::socket (AF_UNIX, SOCK_STREAM, 0);
+        require (raw >= 0, "raw UDS socket");
+        struct sockaddr_un address = {};
+        address.sun_family = AF_UNIX;
+        const std::string path = endpoint.substr (6);
+        require (path.size () < sizeof (address.sun_path), "UDS path length");
+        memcpy (address.sun_path, path.c_str (), path.size () + 1);
+        const int rc = ::connect (raw, reinterpret_cast<sockaddr *> (&address),
+                                  sizeof (address));
+        ::close (raw);
+        require (rc == 0, "raw UDS connect");
+        pump ([&] { return accepted == 19 && disconnected == 19; });
+        require (authenticated == 18,
+                 "raw close does not invent authentication");
+
+        if (version == 2) {
+            require (accepts == closes,
+                     "accepted and closed lifetime bindings");
+            for (const auto &entry : bindings)
+                require (
+                  closes.at (entry.first) == entry.second.fd,
+                  "all ZAP contexts close with their original FD/lifetime");
+        }
+        std::cout << "PASS monitor=" << version << " connections=" << accepted
+                  << " authentications=" << authenticated
+                  << " observed_fd_reuses=" << reused_fds << std::endl;
+    }
+
+  private:
+    void *ctx, *zap, *router, *monitor;
+    int version;
+    std::set<uint64_t> &all_ids;
+    std::vector<void *> sockets;
+    std::string endpoint;
+    int accepted, authenticated, disconnected, requests, handshakes, reused_fds;
+    std::set<uint64_t> seen_fds;
+    std::map<uint64_t, uint64_t> accepts, closes;
+    std::map<uint64_t, binding_t> bindings;
+    std::map<std::string, uint64_t> names;
+    std::vector<std::string> held_reply;
+};
+}
+
+int main ()
+{
+    try {
+        std::set<uint64_t> all_ids;
+        for (int version = 1; version <= 2; ++version) {
+            fixture_t fixture (version, all_ids);
+            fixture.run ();
+        }
+        return 0;
+    }
+    catch (const std::exception &error) {
+        std::cerr << "FAIL " << error.what () << std::endl;
+        return 1;
+    }
+}
