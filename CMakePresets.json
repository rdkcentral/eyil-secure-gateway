{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Native development with L1/L2 and diagnostic tools",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_INSTALL_PREFIX": "/usr",
        "CMAKE_INSTALL_LIBDIR": "lib",
        "BUILD_TESTING": "ON",
        "RDK_SERVICES_L1_TEST": "ON",
        "RDK_SERVICE_L2_TEST": "ON",
        "BUILD_EYIL_DEV_TOOLS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    }
  ],
  "testPresets": [
    {
      "name": "l1",
      "configurePreset": "dev",
      "filter": {
        "include": {
          "label": "^L1$"
        }
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "l2",
      "configurePreset": "dev",
      "filter": {
        "include": {
          "label": "^L2$"
        }
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
